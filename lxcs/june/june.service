[Unit]
Description=June personal companion
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/june/current/src/main.ts
ConditionPathExists=/etc/june/config.json
ConditionPathExists=/etc/june/credentials

[Service]
Type=exec
User=june
Group=june
WorkingDirectory=/opt/june/current
EnvironmentFile=/etc/june/credentials
Environment=HOME=/var/lib/june
Environment=CODEX_HOME=/var/lib/june/.codex
Environment=JUNE_CONFIG=/etc/june/config.json
Environment=RIVETKIT_STORAGE_PATH=/var/lib/june/rivet
Environment=RIVET_RUN_ENGINE_PORT=6420
Environment=RIVET_INSPECTOR_DISABLE=1
Environment=PATH=/opt/node-v24.21.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/node-v24.21.0/bin/node --import tsx src/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
SendSIGKILL=yes
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/june
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true

[Install]
WantedBy=multi-user.target
