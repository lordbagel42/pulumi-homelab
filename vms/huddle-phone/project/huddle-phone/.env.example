# Initialize with: python3 huddle-phone/configure.py
SLACK_WORKSPACE=your-workspace
SLACK_TEAM_ID=T_REPLACE_ME
# Enterprise Grid only: the E... organization ID. TEAM_ID remains the T...
# workspace ID from conversations.info's context_team_id.
SLACK_ENTERPRISE_ID=
SLACK_CHANNEL_ID=C_REPLACE_ME

# The xoxc client token and d cookie from the SAME logged-in Slack user session.
# Keep these local; do not paste credentials into chat or commit this file.
SLACK_CLIENT_TOKEN=xoxc-REPLACE_ME
SLACK_COOKIE='d=xoxd-REPLACE_ME'

# Observe/log only until setup is verified. A huddle observed in dry run is
# never re-rung: start a NEW huddle after enabling calling.
DRY_RUN=true
INCOMING_INVITES=true
OPERATOR_SECRET=
PHONE_CHANNEL=SCCP/6738
RING_SECONDS=30
MAX_CALL_SECONDS=3600
MAX_HUDDLE_AGE_SECONDS=120
POLL_SECONDS=5

# Run Asterisk and the bot on the same Linux VM. Loopback connections only.
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=huddle-phone
AMI_SECRET=GENERATE_ME
AUDIO_PORT=9094
HTTP_PORT=8099

# Region preference sent to Slack rooms.join. Chime media endpoints and join
# token come from Slack; no AWS account, IAM keys, Lambda or PSTN number needed.
CHIME_REGION=us-east-2
