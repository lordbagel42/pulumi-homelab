{
    "compilerOptions": {
        "strict": true,
        "outDir": "bin",
        "target": "es2020",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node", "symbol-observable"],
        "sourceMap": true,
        "experimentalDecorators": true,
        "pretty": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "*.ts",
        "external/**/*.ts",
        "framework/**/*.ts",
        "infisical/**/*.ts",
        "lxcs/**/*.ts",
        "nomad/**/*.ts",
        "utils/**/*.ts",
        "vms/**/*.ts"
    ]
}
